{
  "name": "copilot-hive",
  "displayName": "Copilot Hive",
  "description": "Universal Hive inside GitHub Copilot. Frozen Prime Directive, agent registry, planner, and the GitHub account desk.",
  "version": "1.0.0",
  "publisher": "JACK-SCHITT",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "copilot",
    "hive",
    "github",
    "krackerjack"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "hive",
        "name": "hive",
        "fullName": "Copilot Hive",
        "description": "Hive law, agents, and your GitHub account.",
        "isSticky": true,
        "commands": [
          {
            "name": "seed",
            "description": "Answer under the frozen Prime Directive"
          },
          {
            "name": "agents",
            "description": "List or save a specialization"
          },
          {
            "name": "plan",
            "description": "Show the hive plan checklist"
          },
          {
            "name": "github",
            "description": "Run a GitHub account action"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "copilotHive.signIn",
        "title": "Copilot Hive: Sign in to GitHub"
      },
      {
        "command": "copilotHive.seed",
        "title": "Copilot Hive: Ask the seed"
      },
      {
        "command": "copilotHive.open",
        "title": "Copilot Hive: Open cockpit"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hive",
          "title": "Copilot Hive",
          "icon": "media/hive.svg"
        }
      ]
    },
    "views": {
      "hive": [
        {
          "id": "copilotHive.cockpit",
          "name": "Cockpit",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Copilot Hive",
      "properties": {
        "copilotHive.confirmWrites": {
          "type": "boolean",
          "default": true,
          "description": "Ask before GitHub writes from chat. Language-model tools still use the editor confirmation."
        }
      }
    },
    "languageModelTools": [
      {
        "name": "hive_seed",
        "displayName": "hive seed",
        "modelDescription": "Answer under the frozen Prime Directive. Refuses rewrite, flood, second-master, and account-takeover requests.",
        "toolReferenceName": "hiveSeed",
        "canBeReferencedInPrompt": true,
        "icon": "$(shield)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "description": "Question for the seed"
            },
            "agent": {
              "type": "string",
              "description": "Agent name. Empty specialization means base only."
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "name": "hive_agents",
        "displayName": "hive agents",
        "modelDescription": "List hive agents. Pass save=true with agent and prompt to store an operator specialization. Specializations are never inherited automatically.",
        "toolReferenceName": "hiveAgents",
        "canBeReferencedInPrompt": true,
        "icon": "$(shield)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string",
              "description": "Agent id"
            },
            "prompt": {
              "type": "string",
              "description": "Specialization text to save"
            },
            "save": {
              "type": "boolean",
              "description": "Save the specialization for this operator"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "name": "hive_plan",
        "displayName": "hive plan",
        "modelDescription": "Validate a hive plan. Needs a base, a role, and at least one package. This is a checklist, not an installer.",
        "toolReferenceName": "hivePlan",
        "canBeReferencedInPrompt": true,
        "icon": "$(shield)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "base": {
              "type": "string",
              "description": "Planning base"
            },
            "role": {
              "type": "string",
              "description": "One role"
            },
            "packages": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Plan sections"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "name": "hive_github_me",
        "displayName": "hive github me",
        "modelDescription": "Return the signed-in GitHub user. Same job as reading the account profile.",
        "toolReferenceName": "hiveGithubMe",
        "canBeReferencedInPrompt": true,
